# Copy this file to tests/.env and fill in real values.
# tests/.env is gitignored and must NEVER be committed.
#
# These credentials are read by tests.sh, diagnose.sh, and the new tests/run-all.sh harness.

# WordPress Application Password username (no spaces)
MCP_USERNAME=your-wp-username

# WordPress Application Password (spaces ARE part of the password — quote it)
MCP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Base HTTPS URL of the WordPress instance (no trailing slash)
HTTPS_URL=https://127.0.0.1:9443

# MCP endpoint path (default for the MCP Adapter plugin)
MCP_ENDPOINT_PATH=/wp-json/mcp/mcp-adapter-default-server
